{
  "compilerOptions": {
    "strict": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "target": "esnext",
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist/lib/",
  },
  "include": [
    "src/frbr/*",
    "src/marc/*",
    "src/util/*",
  ],
  "exclude": [
    "./src/cluster/",
    "./tests/",
    "./node_modules/",
    "./dist/",
  ],
}
